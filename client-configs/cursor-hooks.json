{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "<repo_root>/client-configs/cursor-hook.sh"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "<repo_root>/client-configs/cursor-hook.sh"
      }
    ],
    "postToolUse": [
      {
        "command": "<repo_root>/client-configs/cursor-hook.sh",
        "matcher": "Shell|Write|EditNotebook|Delete|Task"
      }
    ],
    "afterAgentResponse": [
      {
        "command": "<repo_root>/client-configs/cursor-hook.sh"
      }
    ],
    "stop": [
      {
        "command": "<repo_root>/client-configs/cursor-hook.sh"
      }
    ],
    "subagentStop": [
      {
        "command": "<repo_root>/client-configs/cursor-hook.sh"
      }
    ],
    "sessionEnd": [
      {
        "command": "<repo_root>/client-configs/cursor-hook.sh"
      }
    ]
  }
}
