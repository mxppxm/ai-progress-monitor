{
  "hooks": {
    "SessionStart": [
      {
        "command": "<repo_root>/.venv/bin/python <repo_root>/scripts/hook_report.py --agent reasonix",
        "description": "ai-progress-monitor: inject choice hint"
      }
    ],
    "UserPromptSubmit": [
      {
        "command": "<repo_root>/.venv/bin/python <repo_root>/scripts/hook_report.py --agent reasonix",
        "description": "ai-progress-monitor: start/restart task"
      }
    ],
    "PreToolUse": [
      {
        "match": "ask",
        "command": "<repo_root>/.venv/bin/python <repo_root>/scripts/hook_report.py --agent reasonix",
        "description": "ai-progress-monitor: ask → yellow pending",
        "timeout": 15000
      }
    ],
    "PermissionRequest": [
      {
        "command": "<repo_root>/.venv/bin/python <repo_root>/scripts/hook_report.py --agent reasonix",
        "description": "ai-progress-monitor: tool permission → yellow pending",
        "timeout": 15000
      }
    ],
    "PostToolUse": [
      {
        "command": "<repo_root>/.venv/bin/python <repo_root>/scripts/hook_report.py --agent reasonix",
        "description": "ai-progress-monitor: heartbeat / resume after user wait"
      }
    ],
    "Notification": [
      {
        "command": "<repo_root>/.venv/bin/python <repo_root>/scripts/hook_report.py --agent reasonix",
        "description": "ai-progress-monitor: any user-attention wait → yellow"
      }
    ],
    "Stop": [
      {
        "command": "<repo_root>/.venv/bin/python <repo_root>/scripts/hook_report.py --agent reasonix",
        "description": "ai-progress-monitor: turn done / choice"
      }
    ],
    "SubagentStop": [
      {
        "command": "<repo_root>/.venv/bin/python <repo_root>/scripts/hook_report.py --agent reasonix",
        "description": "ai-progress-monitor: subagent done"
      }
    ],
    "SessionEnd": [
      {
        "command": "<repo_root>/.venv/bin/python <repo_root>/scripts/hook_report.py --agent reasonix",
        "description": "ai-progress-monitor: session end"
      }
    ]
  }
}
